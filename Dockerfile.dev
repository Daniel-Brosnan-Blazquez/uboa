# Base the image on Rocky Linux (Red Hat compatible)
FROM rockylinux:9

ARG UID_HOST_USER=1000
ARG GID_HOST_USER=1000

RUN groupadd -o -g ${GID_HOST_USER} boa \
    && useradd -m -o -u ${UID_HOST_USER} -g boa boa
RUN yum install -y epel-release \
    && yum install --allowerasing -y glibc-langpack-en less make \
       postgresql postgresql-devel procps python3 python3-devel python3-pip \
       redhat-rpm-config which \
    && yum clean all

RUN python3 -m venv /usr/local/uboa-venv
ENV PATH="/usr/local/uboa-venv/bin:${PATH}"
RUN python -m pip install --upgrade pip setuptools wheel

COPY . /uboa
RUN python -m pip install --editable "/uboa[tests]"
RUN mkdir -p /log /resources_path /datamodel \
    && ln -s /uboa/src/uboa/config/* /resources_path/ \
    && ln -s /uboa/src/uboa/datamodel/uboa_data_model.sql /datamodel/ \
    && chown -R boa:boa /log /resources_path /datamodel /uboa

ENV UBOA_RESOURCES_PATH=/resources_path \
    UBOA_LOG_PATH=/log \
    PYTHONDONTWRITEBYTECODE=1 \
    LC_ALL=en_US.utf-8 \
    LANG=en_US.utf-8

WORKDIR /uboa
USER boa
CMD ["/bin/bash", "/uboa/src/uboa/scripts/start_uboa.sh"]
